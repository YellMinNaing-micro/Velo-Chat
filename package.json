{
  "name": "velo-chat",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "web": "pnpm --filter velochat-client dev",
    "mobile": "pnpm --filter velochat.mobile start",
    "android": "pnpm --filter velochat.mobile android",
    "build": "pnpm --filter velochat-client build",
    "test": "pnpm --filter velochat-client test && pnpm --filter velochat.mobile test",
    "lint": "pnpm --recursive --if-present lint",
    "typecheck": "pnpm --recursive --if-present typecheck"
  }
}
